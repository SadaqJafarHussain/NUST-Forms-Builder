# ============================================================
# NUST Forms Builder — Production Environment
# Copy this file to .env.prod and fill in every value.
# NEVER commit .env.prod to git.
# ============================================================

# ── Public URL (your domain, with https) ────────────────────
WEBAPP_URL=https://forms.yourdomain.com

# ── Database ─────────────────────────────────────────────────
# Strong password for PostgreSQL — no special shell chars (@, #, %, &)
POSTGRES_PASSWORD=replace_with_strong_password

# ── Security keys (generate with: openssl rand -hex 32) ─────
NEXTAUTH_SECRET=replace_with_openssl_rand_hex_32
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
CRON_SECRET=replace_with_openssl_rand_hex_32

# ── Docker image (set by build-push.sh output) ───────────────
DOCKER_IMAGE=yourdockerhubusername/nust-forms-builder:latest

# ── File Storage (S3 or S3-compatible like Cloudflare R2) ───────────
# Required for file uploads (survey backgrounds, file-upload questions, etc.)
# Cloudflare R2 is recommended (free tier, no egress fees)
S3_ACCESS_KEY=your_access_key_id
S3_SECRET_KEY=your_secret_access_key
S3_BUCKET_NAME=your-bucket-name
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# For Amazon S3: leave empty
S3_ENDPOINT_URL=
# For Amazon S3 only: e.g. us-east-1 (optional for R2)
S3_REGION=
# Set to 1 for MinIO or self-hosted S3, 0 for AWS/R2
S3_FORCE_PATH_STYLE=0

# ── Email (optional — enable if you want password reset/verification) ──
# EMAIL_VERIFICATION_DISABLED=0
# PASSWORD_RESET_DISABLED=0
# MAIL_FROM=no-reply@yourdomain.com
# MAIL_FROM_NAME=NUST Forms Builder
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_AUTHENTICATED=true
